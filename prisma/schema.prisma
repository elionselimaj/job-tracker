generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

enum Status {
  APPLIED
  IN_PROGRESS
  INTERVIEW
  OFFER
  REJECTED
  CLOSE_HOLD
}

model Application {
  id            String    @id @default(cuid())
  company       String
  role          String
  source        String?
  appliedAt     DateTime
  status        Status    @default(APPLIED)
  /// Set when the user drags a card to another column. Sync never moves these.
  manuallyMoved Boolean   @default(false)
  gmailThreadId String?
  lastEmailAt   DateTime?
  notes         String    @default("")

  emails ProcessedEmail[]

  @@index([gmailThreadId])
}

/// One row per Gmail message already classified, so nothing is paid for twice.
/// Rows with a review outcome also feed the "Needs review" list.
model ProcessedEmail {
  messageId      String   @id
  threadId       String
  subject        String
  sender         String
  receivedAt     DateTime
  classification String
  company        String?
  role           String?
  outcome        String
  reviewed       Boolean  @default(false)

  applicationId String?
  application   Application? @relation(fields: [applicationId], references: [id], onDelete: SetNull)

  @@index([outcome, reviewed])
}

/// Single row: this is a one-user local app.
model GmailAccount {
  id           Int       @id @default(1)
  email        String
  refreshToken String
  lastSyncAt   DateTime?
}
